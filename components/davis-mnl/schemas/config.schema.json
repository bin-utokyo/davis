{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davis.example/schemas/mnl-config-v1alpha1.json",
  "title": "Davis MNL configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "terms"],
  "properties": {
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "alternative_id", "chosen"],
      "properties": {
        "case_id": {"type": "string"},
        "alternative_id": {"type": "string"},
        "chosen": {"type": "string"},
        "available": {"type": "string"},
        "weight": {"type": "string"}
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter"],
        "properties": {
          "parameter": {"type": "string"},
          "column": {"type": "string"},
          "constant": {"type": "number"},
          "alternatives": {
            "type": "array",
            "items": {"type": ["string", "number"]}
          }
        },
        "oneOf": [
          {"required": ["column"]},
          {"required": ["constant"]}
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "initial": {"type": "number"}
        }
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optimizer": {"enum": ["bfgs", "l-bfgs-b"]},
        "max_iterations": {"type": "integer", "minimum": 1},
        "tolerance": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
