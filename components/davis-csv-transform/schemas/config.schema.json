{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davis.example/schemas/csv-transform-config-v1alpha1.json",
  "title": "Davis CSV transformation configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "joins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "left_on", "right_on", "columns"],
        "properties": {
          "input": {"type": "string", "minLength": 1, "not": {"const": "table"}},
          "how": {"enum": ["left", "inner"], "default": "left"},
          "relationship": {
            "enum": ["many_to_one", "one_to_one"],
            "default": "many_to_one"
          },
          "allow_unmatched": {"type": "boolean", "default": false},
          "left_on": {"$ref": "#/$defs/keyColumns"},
          "right_on": {"$ref": "#/$defs/keyColumns"},
          "columns": {
            "type": "object",
            "description": "Map output column names to source columns in the join input.",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1},
            "propertyNames": {"minLength": 1}
          }
        }
      }
    },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output", "operation", "terms"],
        "properties": {
          "output": {"type": "string", "minLength": 1},
          "operation": {"const": "linear_combination"},
          "replace": {"type": "boolean", "default": false},
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "column": {"type": "string", "minLength": 1},
                "constant": {"type": "number"},
                "coefficient": {"type": "number", "default": 1.0}
              },
              "oneOf": [
                {"required": ["column"]},
                {"required": ["constant"]}
              ]
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {"required": ["joins"]},
    {"required": ["calculations"]}
  ],
  "$defs": {
    "keyColumns": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    }
  }
}
