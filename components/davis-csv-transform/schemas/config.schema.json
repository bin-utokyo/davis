{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davis.example/schemas/csv-transform-config-v1alpha1.json",
  "title": "Davis CSV transformation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["calculations"],
  "properties": {
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output", "operation", "terms"],
        "properties": {
          "output": {"type": "string", "minLength": 1},
          "operation": {"const": "linear_combination"},
          "replace": {"type": "boolean", "default": false},
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "column": {"type": "string", "minLength": 1},
                "constant": {"type": "number"},
                "coefficient": {"type": "number", "default": 1.0}
              },
              "oneOf": [
                {"required": ["column"]},
                {"required": ["constant"]}
              ]
            }
          }
        }
      }
    }
  }
}
